---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<Base
  title="ponderance — Anmol · ML, security & production frontends"
  description="Rigorous systems, folded into things that feel alive. ML and security engineer who ships real production frontends."
>
  <style>
    @keyframes riseIn{0%{opacity:0;transform:translateY(18px);}100%{opacity:1;transform:translateY(0);}}
    @keyframes craneDraw{from{stroke-dashoffset:1;}to{stroke-dashoffset:0;}}
    @keyframes facetIn{0%{opacity:0;transform:scale(.82) rotate(-4deg);}100%{opacity:1;transform:scale(1) rotate(0deg);}}
    @keyframes flapL{0%,100%{transform:rotate(0deg);}50%{transform:rotate(-3.5deg);}}
    @keyframes flapR{0%,100%{transform:rotate(0deg);}50%{transform:rotate(3.5deg);}}
    .rise{animation:riseIn .7s both;}
    .crane-stroke{stroke-dasharray:1;}
    @media (prefers-reduced-motion:reduce){
      .rise{animation:none!important;opacity:1!important;transform:none!important;}
      .crane-stroke{stroke-dashoffset:0!important;animation:none!important;}
      .crane-facet{opacity:1!important;transform:none!important;animation:none!important;}
      .wing-l,.wing-r{animation:none!important;}
    }

    /* Responsive reflow (lifted from Ponderance.dc.html) */
    @media (max-width:880px){
      .home-hero{grid-template-columns:1fr!important;gap:36px!important;padding:44px 0 52px!important;}
      .home-folds{grid-template-columns:1fr!important;}
      .home-latest{grid-template-columns:1fr!important;}
    }
    @media (max-width:768px){
      .home-foot{grid-template-columns:1fr 1fr!important;gap:28px 24px!important;}
      .home-foot .home-foot-lead{grid-column:1 / -1!important;}
    }
    @media (max-width:480px){
      .home-hero-art{max-width:320px;}
      .home-foot{grid-template-columns:1fr!important;}
      .otc-big{font-size:38px!important;}
    }
  </style>

  <!-- HERO: 1180px wide per spec -->
  <section aria-label="Introduction" style="border-bottom: 1px solid var(--color-crease-line-bold);">
    <div style="max-width: 1180px; margin: 0 auto; padding: 0 32px;">
      <div class="home-hero" style="display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; padding: 64px 0 70px;">
        <div>
          <p class="rise" style="font-family: var(--font-mono); font-size: 13px; letter-spacing: .04em; color: var(--color-crease); margin: 0 0 22px; animation-delay: .1s;">crease pattern → crane</p>
          <h1 class="rise" style="font-family: var(--font-display); font-weight: 700; font-size: clamp(44px,5.6vw,76px); line-height: 1.02; letter-spacing: -.025em; color: var(--color-graphite); margin: 0; animation-delay: .2s;">Rigorous systems,<br>folded into things<br>that <span style="color: var(--color-crane);">feel alive.</span></h1>
          <p class="rise" style="font-family: var(--font-body); font-size: 20px; line-height: 1.55; color: var(--color-graphite-60); max-width: 30rem; margin: 26px 0 0; animation-delay: .32s;">I'm an ML and security engineer who ships real production frontends. By day: model work and edge infrastructure. The rest of the time: origami, a saxophone, two cats, and the occasional derivation that wouldn't leave me alone.</p>
          <div class="rise" style="display: flex; align-items: center; gap: 26px; margin-top: 34px; animation-delay: .44s;">
            <a href="/workshop" style="font-family: var(--font-body); font-weight: 600; font-size: 15px; background: var(--color-crane-dark); color: #fff; padding: 13px 22px; border-radius: 3px; text-decoration: none;">See the workshop →</a>
            <a href="/commissions" style="font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--color-graphite-60); border-bottom: 1px solid var(--color-crease-line-bold); padding-bottom: 2px; text-decoration: none;">or commission work →</a>
          </div>
        </div>

        <!-- Signature SVG crane -->
        <div class="home-hero-art" style="position: relative; aspect-ratio: 1.18/1; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; overflow: hidden;">
          <svg viewBox="0 0 460 390" width="100%" height="100%" role="img" aria-label="An origami crease pattern folding into a paper crane" style="display: block;">
            <g stroke="var(--color-crease)" stroke-width="1" fill="none" opacity=".34">
              <path class="crane-stroke" pathLength="1" d="M60 60 L400 60 L400 330 L60 330 Z" style="animation: craneDraw 1s .1s both;"></path>
              <path class="crane-stroke" pathLength="1" d="M60 60 L400 330 M400 60 L60 330 M230 60 L230 330 M60 195 L400 195" style="animation: craneDraw 1.1s .25s both;"></path>
              <path class="crane-stroke" pathLength="1" d="M230 60 L60 195 L230 330 L400 195 Z" style="animation: craneDraw 1.1s .4s both;"></path>
              <path class="crane-stroke" pathLength="1" d="M145 127 L315 127 L315 262 L145 262 Z" style="animation: craneDraw 1s .55s both;"></path>
            </g>
            <g style="transform-origin: 230px 200px;">
              <g class="wing-l" style="transform-origin: 232px 200px; animation: flapL 6.5s ease-in-out 2.4s infinite;">
                <polygon class="crane-facet" points="232,200 96,70 214,196" fill="#C23A1C" style="transform-origin: 200px 150px; animation: facetIn .55s 1.1s both;"></polygon>
              </g>
              <g class="wing-r" style="transform-origin: 232px 200px; animation: flapR 6.5s ease-in-out 2.4s infinite;">
                <polygon class="crane-facet" points="232,200 372,84 252,196" fill="#E84A27" style="transform-origin: 300px 150px; animation: facetIn .55s 1.25s both;"></polygon>
              </g>
              <polygon class="crane-facet" points="214,196 252,196 246,318 198,250" fill="#E84A27" style="transform-origin: 230px 250px; animation: facetIn .55s 1.4s both;"></polygon>
              <polygon class="crane-facet" points="252,196 246,318 300,236" fill="#C23A1C" style="transform-origin: 270px 250px; animation: facetIn .55s 1.5s both;"></polygon>
              <polygon class="crane-facet" points="252,196 300,236 432,212" fill="#EF7853" style="transform-origin: 360px 215px; animation: facetIn .55s 1.6s both;"></polygon>
              <polygon class="crane-facet" points="214,196 232,200 150,150 92,118" fill="#EF7853" style="transform-origin: 160px 150px; animation: facetIn .55s 1.7s both;"></polygon>
              <polygon class="crane-facet" points="92,118 150,150 78,166" fill="#E84A27" style="transform-origin: 110px 145px; animation: facetIn .55s 1.78s both;"></polygon>
              <g class="crane-facet" stroke="var(--color-crease)" stroke-width="1" opacity=".5" fill="none" style="animation: facetIn .5s 1.9s both;">
                <path d="M232,200 L214,196 M232,200 L252,196 M232,200 L246,318 M252,196 L300,236"></path>
              </g>
            </g>
          </svg>
          <span style="position: absolute; bottom: 12px; right: 14px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em; color: var(--color-graphite-40);">grus japonensis</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED BUILD + THREE FOLDS -->
  <section aria-label="Featured work" style="border-bottom: 1px solid var(--color-crease-line-bold);">
    <div style="max-width: 1080px; margin: 0 auto; padding: 0 32px;">
      <div class="home-folds" style="display: grid; grid-template-columns: 1.15fr .85fr; gap: 28px; padding: 56px 0;">
        <!-- Featured build -->
        <article style="position: relative; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; padding: 30px 32px 32px; overflow: hidden;">
          <div aria-hidden="true" style="position: absolute; top: 0; right: 0; width: 34px; height: 34px; background: linear-gradient(135deg,transparent 50%,var(--color-crease-line) 50%); border-left: 1px solid var(--color-crease-line-bold); border-bottom: 1px solid var(--color-crease-line-bold);"></div>          <h2 style="font-family: var(--font-display); font-weight: 600; font-size: 30px; letter-spacing: -.02em; color: var(--color-graphite); margin: 0 0 8px;">shreyachanth.com</h2>
          <p style="font-family: var(--font-body); font-size: 16.5px; line-height: 1.55; color: var(--color-graphite-60); margin: 0 0 22px; max-width: 34rem;">A full production build on Cloudflare, with Turnstile and rate-limited functions guarding the inquiry path, R2 for media, a CI gate that won't merge until it passes, and an editing flow a non-technical client actually uses without calling me. WCAG AA throughout.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px;">
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--color-graphite-60); border: 1px solid var(--color-crease-line-bold); border-radius: 2px; padding: 4px 9px;">Cloudflare Workers</span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--color-graphite-60); border: 1px solid var(--color-crease-line-bold); border-radius: 2px; padding: 4px 9px;">Turnstile</span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--color-graphite-60); border: 1px solid var(--color-crease-line-bold); border-radius: 2px; padding: 4px 9px;">R2</span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--color-graphite-60); border: 1px solid var(--color-crease-line-bold); border-radius: 2px; padding: 4px 9px;">CI-gated</span>
          </div>
          <a href="/workshop/shreyachanth" style="font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--color-crane); border-bottom: 1px solid var(--color-crane); padding-bottom: 2px; text-decoration: none;">Read the case study →</a>
        </article>

        <!-- Three folds -->
        <div style="display: flex; flex-direction: column; gap: 18px;">
          <h2 style="font-family: var(--font-display); font-weight: 600; font-size: 23px; letter-spacing: -.015em; color: var(--color-graphite); margin: 0; max-width: 14ch;">Three folds of one sheet</h2>
          <div style="position: relative; display: flex; flex-direction: column; gap: 12px; padding-left: 26px; border-left: 1px solid var(--color-crease-line-bold);">
            <div style="position: relative; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; padding: 16px 20px;">
              <span aria-hidden="true" style="position: absolute; left: -31px; top: 21px; width: 10px; height: 10px; background: var(--color-crane); transform: rotate(45deg);"></span>
              <h3 style="font-family: var(--font-display); font-weight: 600; font-size: 18px; color: var(--color-graphite); margin: 0 0 3px;">Machine learning</h3>
              <p style="font-family: var(--font-body); font-size: 14.5px; line-height: 1.5; color: var(--color-graphite-60); margin: 0;">Model work, including contributions to IBM Granite.</p>
            </div>
            <div style="position: relative; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; padding: 16px 20px;">
              <span aria-hidden="true" style="position: absolute; left: -31px; top: 21px; width: 10px; height: 10px; background: var(--color-crease); transform: rotate(45deg);"></span>
              <h3 style="font-family: var(--font-display); font-weight: 600; font-size: 18px; color: var(--color-graphite); margin: 0 0 3px;">Security</h3>
              <p style="font-family: var(--font-body); font-size: 14.5px; line-height: 1.5; color: var(--color-graphite-60); margin: 0;">Research, and the paranoia that keeps builds honest.</p>
            </div>
            <div style="position: relative; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; padding: 16px 20px;">
              <span aria-hidden="true" style="position: absolute; left: -31px; top: 21px; width: 10px; height: 10px; background: var(--color-sax); transform: rotate(45deg);"></span>
              <h3 style="font-family: var(--font-display); font-weight: 600; font-size: 18px; color: var(--color-graphite); margin: 0 0 3px;">Frontend + infra</h3>
              <p style="font-family: var(--font-body); font-size: 14.5px; line-height: 1.5; color: var(--color-graphite-60); margin: 0;">Production sites with real CI/CD and edge deploys.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST FROM MARGINALIA -->
  <section aria-label="Latest notes" style="border-bottom: 1px solid var(--color-crease-line-bold);">
    <div style="max-width: 1080px; margin: 0 auto; padding: 0 32px;">
      <div style="padding: 54px 0;">
        <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 26px;">
          <h2 style="font-family: var(--font-display); font-weight: 600; font-size: 28px; letter-spacing: -.02em; color: var(--color-graphite); margin: 0;">Latest from Marginalia</h2>
          <a href="/marginalia" style="font-family: var(--font-body); font-weight: 600; font-size: 14.5px; color: var(--color-crease); text-decoration: none;">All notes →</a>
        </div>
        <div class="home-latest" style="display: grid; grid-template-columns: 1.55fr 1fr; gap: 18px; align-items: stretch;">
          {notes[0] && (
            <a href={`/marginalia/${notes[0].id}`} style="position: relative; display: flex; flex-direction: column; justify-content: flex-end; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; padding: 30px 32px 28px; min-height: 188px; overflow: hidden; text-decoration: none;">
              <div aria-hidden="true" style="position: absolute; top: 0; right: 0; width: 38px; height: 38px; background: linear-gradient(135deg,transparent 50%,var(--color-crease-line) 50%); border-left: 1px solid var(--color-crease-line-bold); border-bottom: 1px solid var(--color-crease-line-bold);"></div>
              <span style="font-family: var(--font-mono); font-size: 12px; color: var(--color-graphite-40); margin-bottom: 12px;">
                {notes[0].data.date.toISOString().slice(0,10)} · <span style="color: var(--color-sax);">{notes[0].data.tags.join(' · ')}</span>
              </span>
              <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 27px; line-height: 1.1; color: var(--color-graphite); margin: 0 0 8px; letter-spacing: -.015em; max-width: 18ch;">{notes[0].data.title}</h3>
              <p style="font-family: var(--font-body); font-size: 16px; line-height: 1.55; color: var(--color-graphite-60); margin: 0; max-width: 42ch;">{notes[0].data.summary}</p>
            </a>
          )}
          {notes[1] && (
            <a href={`/marginalia/${notes[1].id}`} style="display: flex; flex-direction: column; justify-content: flex-end; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 4px; padding: 22px 24px; text-decoration: none;">
              <span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--color-graphite-40); margin-bottom: 10px;">
                {notes[1].data.date.toISOString().slice(0,10)} · <span style="color: var(--color-sax);">{notes[1].data.tags.join(' · ')}</span>
              </span>
              <h3 style="font-family: var(--font-display); font-weight: 600; font-size: 19px; line-height: 1.15; color: var(--color-graphite); margin: 0 0 6px; letter-spacing: -.01em;">{notes[1].data.title}</h3>
              <p style="font-family: var(--font-body); font-size: 14.5px; line-height: 1.5; color: var(--color-graphite-60); margin: 0;">{notes[1].data.summary}</p>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- OFF THE CLOCK -->
  <section aria-label="Off the clock" style="border-bottom: 1px solid var(--color-crease-line-bold);">
    <div style="max-width: 1080px; margin: 0 auto; padding: 0 32px;">
      <div style="padding: 46px 0;">
        <h2 style="font-family: var(--font-display); font-weight: 600; font-size: 28px; letter-spacing: -.02em; color: var(--color-graphite); margin: 0 0 22px;">Off the clock</h2>
        <div style="position: relative; background: var(--color-graph-card); border: 1px solid var(--color-crease-line-bold); border-radius: 5px; padding: 40px 44px 42px; overflow: hidden;">
          <div aria-hidden="true" style="position: absolute; top: 0; right: 0; width: 46px; height: 46px; background: linear-gradient(135deg,transparent 50%,var(--color-crease-line) 50%); border-left: 1px solid var(--color-crease-line-bold); border-bottom: 1px solid var(--color-crease-line-bold);"></div>
          <div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px 30px; max-width: 46rem;">
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 46px; letter-spacing: -.02em; color: var(--color-graphite); line-height: .95;" class="otc-big">origami</span>
            <span aria-hidden="true" style="color: var(--color-crane); font-size: 18px; transform: translateY(-6px);">◆</span>
            <span style="font-family: var(--font-display); font-weight: 500; font-size: 26px; color: var(--color-graphite);">the saxophone</span>
            <span aria-hidden="true" style="font-family: var(--font-mono); font-size: 22px; color: var(--color-sax);">♪</span>
            <span style="font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 22px; color: var(--color-orbit-ink);">deep space</span>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 38px; letter-spacing: -.02em; color: var(--color-graphite); line-height: .95;" class="otc-big">two cats</span>
            <span style="font-family: var(--font-mono); font-size: 14px; color: var(--color-graphite-60); border: 1px solid var(--color-crease-line-bold); border-radius: 2px; padding: 5px 11px;">the Bambu printer</span>
            <span style="font-family: var(--font-display); font-weight: 600; font-size: 30px; color: var(--color-graphite);">Doctor Who</span>
            <span style="font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 20px; color: var(--color-sax);">jazz at 1am</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOME EXPANDED FOOTER -->
  <footer slot="footer" style="border-top: 1px solid var(--color-crease-line-bold);">
    <div style="max-width: 1080px; margin: 0 auto; padding: 0 32px;">
      <div class="home-foot" style="padding: 50px 0 64px; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 32px; align-items: start;">
        <div class="home-foot-lead">
          <p style="font-family: var(--font-display); font-weight: 700; font-size: 22px; letter-spacing: -.02em; color: var(--color-graphite); margin: 0 0 8px;">Let's fold something.</p>
          <p style="font-family: var(--font-body); font-size: 15px; line-height: 1.55; color: var(--color-graphite-60); margin: 0 0 16px; max-width: 24rem;">Commissions open for the right project. Notes in the margins, always.</p>
          <a href="mailto:hello@ponderance.dev" style="font-family: var(--font-mono); font-size: 14px; color: var(--color-crane); border-bottom: 1px solid var(--color-crane); padding-bottom: 2px; text-decoration: none;">hello@ponderance.dev</a>
        </div>
        <div>
          <p style="font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-crease); margin: 0 0 14px;">Pages</p>
          <div style="display: flex; flex-direction: column; gap: 9px; font-family: var(--font-body); font-size: 15px; color: var(--color-graphite-60);">
            <a href="/whoami" style="text-decoration: none; color: inherit;">Whoami</a>
            <a href="/workshop" style="text-decoration: none; color: inherit;">Workshop</a>
            <a href="/commissions" style="text-decoration: none; color: inherit;">Commissions</a>
            <a href="/marginalia" style="text-decoration: none; color: inherit;">Marginalia</a>
            <a href="/colophon" style="text-decoration: none; color: inherit;">Colophon</a>
          </div>
        </div>
        <div>
          <p style="font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-crease); margin: 0 0 14px;">Elsewhere</p>
          <div style="display: flex; flex-direction: column; gap: 9px; font-family: var(--font-body); font-size: 15px; color: var(--color-graphite-60);">
            <a href="https://github.com/AnmolS1" style="text-decoration: none; color: inherit;">GitHub</a>
            <a href="/rss.xml" style="text-decoration: none; color: inherit;">RSS</a>
          </div>
        </div>
      </div>
      <div style="border-top: 1px solid var(--color-crease-line-bold); padding: 18px 0 40px; display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11.5px; color: var(--color-graphite-40);">
        <span>© 2026 Anmol · ponderance.dev</span>
        <span>Astro 6 · Cloudflare · self-hosted type · <a href="/colophon" style="color: var(--color-crease); text-decoration: none;">colophon</a></span>
      </div>
    </div>
  </footer>
</Base>
