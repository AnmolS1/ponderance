---
/**
 * CoverArt — inlines a build-time SVG so it inherits the page's theme tokens
 * (var(--color-*)) and reacts to the manual data-theme toggle, instead of being
 * an isolated <img>. Read from /public at build (output: 'static' → Node).
 *
 *  fit="cover"   → fills its box (preserveAspectRatio slice); pair with a class
 *                  that sets the box ratio (e.g. .build-cover).
 *  fit="contain" → letterboxes inside its box (meet); fills width+height 100%.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  fit?: 'cover' | 'contain';
  class?: string;
}
const { src, fit = 'cover', class: className } = Astro.props;

let raw = '';
try {
  raw = fs.readFileSync(path.join(process.cwd(), 'public', src), 'utf-8').trim();
} catch {
  console.warn(`[CoverArt] could not read ${src}`);
}

const par = fit === 'cover' ? 'xMidYMid slice' : 'xMidYMid meet';
const style = fit === 'contain'
  ? 'width:100%;height:100%;display:block'
  : 'width:100%;display:block';
const attrs = [
  `preserveAspectRatio="${par}"`,
  `style="${style}"`,
  className ? `class="${className}"` : '',
].filter(Boolean).join(' ');

if (raw) raw = raw.replace(/<svg\b/, `<svg ${attrs}`);
---
<Fragment set:html={raw} />
