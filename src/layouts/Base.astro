---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional right-side content for the footer (e.g. contextual link) */
  footerLink?: { href: string; label: string };
  /** Absolute canonical URL. Emitted only when a page asks for one. */
  canonical?: string;
}

const {
  title,
  description = 'Rigorous systems, folded into things that feel alive.',
  ogImage = '/og-image.png',
  footerLink,
  canonical,
} = Astro.props;

const site = Astro.site!;
const ogImageURL = new URL(ogImage, site).href;
const faviconSVG = new URL('/favicon.svg', site).href;
const faviconICO = new URL('/favicon.ico', site).href;
const appleTouchIcon = new URL('/apple-touch-icon.png', site).href;

const path = Astro.url.pathname;

const navLinks = [
  { href: '/',            label: 'Ponderance',  num: '01' },
  { href: '/whoami',      label: 'Whoami',      num: '02' },
  { href: '/workshop',    label: 'Workshop',    num: '03' },
  { href: '/commissions', label: 'Commissions', num: '04' },
  { href: '/marginalia',  label: 'Marginalia',  num: '05' },
];

function isActive(href: string) {
  return href === '/' ? path === '/' : path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={faviconSVG} />
    <link rel="icon" href={faviconICO} />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <meta name="theme-color" content="#EEF0EC" />

    <!-- Pre-paint theme init (no flash): sets data-theme from cp-theme / system
         before first paint. External + render-blocking to satisfy script-src
         'self' and the no-inline-script gate; the deferred crease.js wires the
         toggle + menu once the page is interactive. -->
    <script is:inline src="/scripts/crease-theme.js"></script>

    <!-- Title & description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="ponderance.dev" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />
  </head>

  <body>
    <!-- Skip navigation link (visually hidden until focused) -->
    <a href="#main" class="cp-skip">Skip to content</a>

    <!-- ── Header / nav ─────────────────────────────────── -->
    <header class="cp-header">
      <div class="cp-header-in">
        <!-- Brand -->
        <a href="/" aria-label="ponderance — home" class="cp-brand">
          <img src="/logo-amber.svg" width="30" height="30" alt="" aria-hidden="true" />
          <span class="cp-brand-name">ponderance</span>
          <span class="cp-brand-sub">/ anmol</span>
        </a>

        <!-- Desktop nav (folds into the sheet menu at ≤860px) -->
        <nav class="cp-nav" aria-label="Primary">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              class="cp-nav-link"
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </nav>

        <!-- Theme toggle (every width) + hamburger (≤860px) -->
        <div class="cp-bar-right">
          <button class="cp-toggle" type="button" data-cp-toggle aria-label="Switch to dark theme" aria-pressed="false">
            <span class="cp-chip" aria-hidden="true"></span>
            <span class="cp-toggle-label" aria-hidden="true"></span>
          </button>
          <button class="cp-burger" type="button" data-cp-burger aria-label="Open menu" aria-expanded="false" aria-controls="cp-menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- ── Fold-out mobile menu ─────────────────────────── -->
    <div class="cp-menu" id="cp-menu" role="dialog" aria-modal="true" aria-label="Site menu">
      <nav class="cp-menu-links" aria-label="Mobile primary">
        {navLinks.map(({ href, label, num }) => (
          <a
            href={href}
            class="cp-menu-link"
            aria-current={isActive(href) ? 'page' : undefined}
          >
            <span class="cp-mk" aria-hidden="true"></span>{label}<span class="cp-menu-num">{num}</span>
          </a>
        ))}
      </nav>
      <div class="cp-menu-foot">
        <a href="mailto:anmol@ponderance.dev">anmol@ponderance.dev</a>
        <a href="/support" data-cp-menu-close>Support</a>
        <a href="/privacy" data-cp-menu-close>Privacy</a>
        <a href="/terms" data-cp-menu-close>Terms</a>
        <a href="/colophon" data-cp-menu-close>Colophon →</a>
        <button class="cp-toggle" type="button" data-cp-toggle aria-label="Switch to dark theme" aria-pressed="false">
          <span class="cp-chip" aria-hidden="true"></span>
          <span class="cp-toggle-label" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <!-- ── Main content ──────────────────────────────────── -->
    <main id="main">
      <slot />
    </main>

    <!-- ── Footer (expanded home footer overrides via the slot) ─── -->
    <slot name="footer">
      <footer class="cp-foot">
        <div class="cp-foot-in">
          <span>© 2026 Anmol · ponderance.dev</span>
          <span style="display: inline-flex; gap: 16px; align-items: center; flex-wrap: wrap;">
            <a href="/support">Support</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            {footerLink && (
              <a href={footerLink.href}>{footerLink.label}</a>
            )}
          </span>
        </div>
      </footer>
    </slot>

    <!-- Chrome behaviour: toggle + fold-out menu + live OS-follow. External, CSP-clean. -->
    <script is:inline type="module" src="/scripts/crease.js"></script>
  </body>
</html>
