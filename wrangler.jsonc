// wrangler.jsonc — root config read by @astrojs/cloudflare at build time.
// The adapter merges this with its own build output and emits the final
// deploy-ready config at dist/server/wrangler.json (main: "entry.mjs",
// no_bundle: true, assets binding, etc.). CI always deploys that generated
// file — this file is never passed directly to `wrangler deploy`.
{
  "name": "ponderance-preview",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  // Adapter sets main, directory, and the ASSETS binding. We own not_found_handling.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "2b67b00d20de4e1b84db2dcb48a48980" }
  ],
  // CRITICAL: exactly two entries, no wildcards, no *.ponderance.dev
  "routes": [
    { "pattern": "ponderance.dev", "custom_domain": true },
    { "pattern": "www.ponderance.dev", "custom_domain": true }
  ]
}
